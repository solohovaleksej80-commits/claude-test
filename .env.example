# ──────────────────────────────────────────────────────────────
# TradeSim — учебный симулятор (DEMO). Реальные деньги не используются.
# ──────────────────────────────────────────────────────────────

# Telegram bot token (нужен только для запуска бота, не для API/симулятора)
BOT_TOKEN=

# Telegram ID администраторов через запятую (доступ к /admin)
ADMIN_IDS=

# База данных. По умолчанию — локальный SQLite-файл.
# Для PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/tradesim
DATABASE_URL=sqlite:///./tradesim.db

# Стартовый виртуальный баланс новых пользователей (учебные единицы)
START_BALANCE=1000

# Режим разработки: если true, авторизация Mini App не требует подписи Telegram
# (позволяет открывать фронтенд в обычном браузере). В проде — false.
DEV_MODE=true

# Секрет для подписи JWT (dev-значение, замените в проде)
JWT_SECRET=dev-secret-change-me

# URL Mini App (для кнопок в боте)
WEBAPP_URL=http://localhost:5500
